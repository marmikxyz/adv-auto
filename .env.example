BOT_TOKEN=123456:ABC...            # from @BotFather
API_ID=1234567                     # from https://my.telegram.org
API_HASH=0123456789abcdef0123456789abcdef
TG_SESSION=                        # from gen_session.py
CHANNELS=-1001111111111,-1002222222222,@somepublicchannel
OWNER_IDS=123456789                # your Telegram user id (comma separated)
DATABASE_URL=                      # Railway: ${{Postgres.DATABASE_URL}}

# optional
CACHE_DAYS=30                      # a keyword is searched with Telethon again after this many days
PER_CHANNEL_LIMIT=200              # max messages read per channel for one keyword
GROUP_FILES_TO_DM=true             # tap in a group -> file goes to the user's DM
CLEAN_MIN=1                        # delete search results after N minutes (0 = off)
FILE_DELETE_MIN=10                 # delete sent files after N minutes (0 = off)
WELCOME_TEXT=
WELCOME_PHOTO=
SUPPORT_URL=
